{
  "name": "memo-management-system",
  "version": "1.0.0",
  "description": "Multi-tenant Inter-Office Memo Management System",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w frontend\" \"npm run dev --prefix backend\"",
    "dev:api": "npx vercel dev --listen 3000",
    "build": "prisma generate && npm run build -w frontend",
    "start": "npm run build -w frontend",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "reset:owner": "tsx scripts/reset-platform-owner.ts",
    "test:audit": "node scripts/audit-role-tests.mjs",
    "test:e2e": "playwright test e2e/api-workflow.spec.ts",
    "test:e2e:ui": "playwright test e2e/roles.spec.ts",
    "test": "npm run test:audit && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@vercel/node": "^5.5.16",
    "concurrently": "^8.2.2",
    "prisma": "^5.13.0",
    "tsx": "^4.7.0",
    "vercel": "^59.9.1"
  },
  "dependencies": {
    "@prisma/client": "^5.13.0",
    "@supabase/supabase-js": "^2.45.0",
    "zod": "^3.22.4"
  }
}
